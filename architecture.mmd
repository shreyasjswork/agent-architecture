flowchart LR
    REQUEST["User request"] --> SCOPE["Task scope and acceptance checks"]
    SCOPE --> ROUTE["Shared workflow and project rules"]
    ROUTE --> ADAPTER["Provider adapter"]
    ADAPTER --> IMPLEMENT["Implementation and local checks"]
    IMPLEMENT --> FREEZE["Freeze a candidate Git commit"]
    FREEZE --> REVIEW["Independent review of that commit"]
    REVIEW --> DECISION{"Checks and review pass?"}
    DECISION -->|"Fix"| IMPLEMENT
    DECISION -->|"Pass"| AUTH["Apply the project publication decision"]
    AUTH --> LIVE["Verify the merged or deployed result"]
    LIVE --> HEALTH["Record outcome and review coverage"]
